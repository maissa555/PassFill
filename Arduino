bool loadActiveTotpFromEntry(int entryIndex) {
  if (entryIndex < 0 || entryIndex >= passwordMenuCount) {
    return false;
  }

  if (passwordTotpSecretValues[entryIndex][0] == '\0') {
    return false;
  }

  activeTotpSecretLen = decodeBase32(
    passwordTotpSecretValues[entryIndex],
    activeTotpSecret,
    sizeof(activeTotpSecret)
  );

  if (activeTotpSecretLen == 0) {
    return false;
  }

  if (activeTotp != nullptr) {
    delete activeTotp;
    activeTotp = nullptr;
  }

  activeTotp = new TOTP(activeTotpSecret, activeTotpSecretLen);
  activeTotpEntryIndex = entryIndex;

  return true;
}

void openSelectedItem() {
  if (currentScreen == SCREEN_MAIN) {
    if (selectedIndex == 0) {
      currentScreen = SCREEN_PASSWORDS;
      selectedIndex = 0;
      menuScrollOffset = 0;
      drawMenu();
      return;
    }

    if (selectedIndex == 1) {
      currentScreen = SCREEN_TOTP;
      selectedIndex = 0;
      menuScrollOffset = 0;
      drawMenu();
      return;
    }

    if (selectedIndex == 2) {
      currentScreen = SCREEN_SETTINGS;
      selectedIndex = 0;
      menuScrollOffset = 0;
      startSettingsPortal();
      return;
    }
  }

  if (currentScreen == SCREEN_PASSWORDS) {
    activePasswordIndex = selectedIndex;
    currentScreen = SCREEN_PASSWORD_ACTIONS;
    selectedIndex = 0;
    menuScrollOffset = 0;
    drawMenu();
    return;
  }

  if (currentScreen == SCREEN_TOTP) {
    int entryIndex = getTotpEntryIndexByVisibleIndex(selectedIndex);

    if (!loadActiveTotpFromEntry(entryIndex)) {
      showStatusScreen("TOTP Error", "Invalid secret");
      delay(1200);
      drawMenu();
      return;
    }

    if (!timeSynced) {
      if (!syncTimeOverWiFi()) {
        drawMenu();
        return;
      }

      timeSynced = true;
    }

    currentScreen = SCREEN_TOTP_VIEW;
    lastTotpRedraw = 0;
    return;
  }

  if (currentScreen == SCREEN_PASSWORD_ACTIONS) {
    showSendingScreen(passwordNameValues[activePasswordIndex]);
    delay(300);

    if (selectedIndex == 0) {
      Keyboard.print(passwordUsernameValues[activePasswordIndex]);
    } else if (selectedIndex == 1) {
      Keyboard.print(passwordTextValues[activePasswordIndex]);
    } else if (selectedIndex == 2) {
      Keyboard.print(passwordUsernameValues[activePasswordIndex]);
      delay(150);
      Keyboard.write(KEY_TAB);
      delay(250);
      Keyboard.print(passwordTextValues[activePasswordIndex]);
    }

    delay(600);
    drawMenu();
    return;
  }
}

void handleTouch() {
  static unsigned long lastTouchMs = 0;

  if (!touch.touched()) return;

  unsigned long now = millis();

  if (now - lastTouchMs < 250) return;
  lastTouchMs = now;

  TS_Point p = touch.getPoint();

  int x = map(p.x, 200, 3900, 0, gfx->width());
  int y = map(p.y, 200, 3900, 0, gfx->height());
  //for Settings
  if (settingsPortalActive) {
    // Back button
    if (x < 130 && y > 190) {
      stopSettingsPortal();
      currentScreen = SCREEN_MAIN;
      selectedIndex = 0;
      menuScrollOffset = 0;
      drawMenu();
      return;
    }
    // Tap center area to type AP password
    if (x >= 60 && x <= 280 && y >= 70 && y <= 130) {
      Keyboard.print(settingsApPassword);
      return;
    }
    return;
  }
  //for TOTP
  if (currentScreen == SCREEN_TOTP_VIEW) {
    if (x < 130 && y > 190) {
      handleBackAction();
      return;
    }
    if (x >= 30 && x <= 290 && y >= 55 && y <= 150) {
      time_t nowTime;

      if (!getCurrentUnixTime(nowTime)) {
        return;
      }

      if (activeTotp == nullptr || activeTotpEntryIndex < 0) {
        return;
      }

      char* code = activeTotp->getCode(nowTime);
      Keyboard.print(code);

      showSendingScreen(passwordNameValues[activeTotpEntryIndex]);
      delay(600);

      lastTotpRedraw = 0;
      return;
    }

    return;
  }

  Serial.print("Touch x=");
  Serial.print(x);
  Serial.print(" y=");
  Serial.println(y);

  // Large back button zone
  if (currentScreen != SCREEN_MAIN && x < 130 && y > 190) {
    handleBackAction();
    return;
  }

  int itemCount = getCurrentMenuCount();

  if (itemCount <= 0) {
    return;
  }

  const int startY = 58;
  const int cardHeight = 38;
  const int cardGap = 8;
  const int visibleItems = 4;

  for (int row = 0; row < visibleItems; row++) {
    int cardY = startY + row * (cardHeight + cardGap);
    int tappedIndex = menuScrollOffset + row;

    if (tappedIndex >= itemCount) continue;

    if (x >= 14 && x <= 306 && y >= cardY && y <= cardY + cardHeight) {
      selectedIndex = tappedIndex;
      drawMenu();
      delay(120);
      openSelectedItem();
      return;
    }
  }
}

int base32Value(char c) {
  if (c >= 'A' && c <= 'Z') return c - 'A';
  if (c >= 'a' && c <= 'z') return c - 'a';
  if (c >= '2' && c <= '7') return c - '2' + 26;
  return -1;
}

size_t decodeBase32(const char* input, uint8_t* output, size_t maxOutputLen) {
  int buffer = 0;
  int bitsLeft = 0;
  size_t outLen = 0;

  while (*input) {
    char c = *input++;

    if (c == ' ' || c == '=' || c == '-') continue;

    int val = base32Value(c);
    if (val < 0) continue;

    buffer = (buffer << 5) | val;
    bitsLeft += 5;

    if (bitsLeft >= 8) {
      bitsLeft -= 8;

      if (outLen >= maxOutputLen) return 0;

      output[outLen++] = (buffer >> bitsLeft) & 0xFF;
    }
  }

  return outLen;
}



