  html += "<input name='item_totp' placeholder='TOTP Base32 secret, optional'>";
  html += "<button type='submit'>Add</button>";
  html += "</form></div>";

  html += "<div class='card'><h2>Saved Passwords</h2>";
  html += "<table><tr><th>Name</th><th>Username</th><th>TOTP</th><th>Action</th></tr>";

  for (int i = 0; i < passwordMenuCount; i++) {
    html += "<tr>";
    html += "<td>" + htmlEscape(passwordNameValues[i]) + "</td>";
    html += "<td>" + htmlEscape(passwordUsernameValues[i]) + "</td>";
    html += "<td>";
    html += (passwordTotpSecretValues[i][0] != '\0') ? "Yes" : "No";
    html += "</td>";
    html += "<td><a class='btn delete' href='/delete?index=" + String(i) + "'>Delete</a></td>";
    html += "</tr>";
  }

  html += "</table></div>";
  html += "</div></body></html>";

  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "text/html", html);
}
//save & delete handlers
void handlePortalSave() {
  String itemName = server.arg("item_name");
  String itemUser = server.arg("item_user");
  String itemPass = server.arg("item_pass");

  String itemTotp = server.arg("item_totp");
  bool hasTotp = server.hasArg("has_totp");

  itemTotp.trim();
  itemTotp.replace(" ", "");
  itemTotp.replace("-", "");
  itemTotp.toUpperCase();

  if (hasTotp && itemTotp.length() == 0) {
    server.send(200, "text/html", "<html><body><h2>TOTP secret required when TOTP is checked</h2><a href='/'>Back</a></body></html>");
    return;
  }
  itemName.trim();
  itemUser.trim();
  itemPass.trim();

  if (itemName.length() == 0 || itemPass.length() == 0) {
    server.send(200, "text/html", "<html><body><h2>Name and password required</h2><a href='/'>Back</a></body></html>");
    return;
  }

  if (passwordMenuCount >= MAX_PASSWORD_ITEMS) {
    server.send(200, "text/html", "<html><body><h2>Storage full</h2><a href='/'>Back</a></body></html>");
    return;
  }

  itemName.toCharArray(passwordNameValues[passwordMenuCount], sizeof(passwordNameValues[passwordMenuCount]));
  itemUser.toCharArray(passwordUsernameValues[passwordMenuCount], sizeof(passwordUsernameValues[passwordMenuCount]));
  itemPass.toCharArray(passwordTextValues[passwordMenuCount], sizeof(passwordTextValues[passwordMenuCount]));
  if (hasTotp) {
    itemTotp.toCharArray(passwordTotpSecretValues[passwordMenuCount], sizeof(passwordTotpSecretValues[passwordMenuCount]));
  } else {
    passwordTotpSecretValues[passwordMenuCount][0] = '\0';
  }

  passwordMenuCount++;

  savePasswordsToPreferences();

  server.sendHeader("Location", "/");
  server.send(303);
}

void handlePortalDelete() {
  if (!server.hasArg("index")) {
    server.sendHeader("Location", "/");
    server.send(303);
    return;
  }

  int deleteIndex = server.arg("index").toInt();

  if (deleteIndex < 0 || deleteIndex >= passwordMenuCount) {
    server.sendHeader("Location", "/");
    server.send(303);
    return;
  }

  for (int i = deleteIndex; i < passwordMenuCount - 1; i++) {
    strlcpy(passwordNameValues[i], passwordNameValues[i + 1], sizeof(passwordNameValues[i]));
    strlcpy(passwordUsernameValues[i], passwordUsernameValues[i + 1], sizeof(passwordUsernameValues[i]));
    strlcpy(passwordTextValues[i], passwordTextValues[i + 1], sizeof(passwordTextValues[i]));
    strlcpy(passwordTotpSecretValues[i], passwordTotpSecretValues[i + 1], sizeof(passwordTotpSecretValues[i]));
  }

  passwordMenuCount--;
  passwordNameValues[passwordMenuCount][0] = '\0';
  passwordUsernameValues[passwordMenuCount][0] = '\0';
  passwordTextValues[passwordMenuCount][0] = '\0';
  passwordTotpSecretValues[passwordMenuCount][0] = '\0';

  savePasswordsToPreferences();

  server.sendHeader("Location", "/");
  server.send(303);
}
//start/stop portal functions
void stopSettingsPortal();
void startSettingsPortal() {
  stopSettingsPortal();

  WiFi.disconnect(true, true);
  WiFi.softAPdisconnect(true);
  delay(200);

  WiFi.mode(WIFI_AP);
  delay(100);

  bool apStarted = WiFi.softAP("PassFill", settingsApPassword.c_str());
  delay(300);

  if (!apStarted) {
    showStatusScreen("AP Failed", "Check password length");
    delay(1200);
    currentScreen = SCREEN_MAIN;
    drawMenu();
    return;
  }

  server.stop();
  dnsServer.stop();

  dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());

  server.on("/", HTTP_GET, handlePortalRoot);
  server.on("/save", HTTP_POST, handlePortalSave);
  server.on("/delete", HTTP_GET, handlePortalDelete);

  server.on("/generate_204", HTTP_GET, handlePortalRoot);
  server.on("/hotspot-detect.html", HTTP_GET, handlePortalRoot);
  server.on("/ncsi.txt", HTTP_GET, handlePortalRoot);
  server.onNotFound(handlePortalRoot);

  server.begin();

  settingsPortalActive = true;
  drawSettingsPortalScreen();
}

void stopSettingsPortal() {
  if (!settingsPortalActive) return;

  dnsServer.stop();
  server.stop();
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_OFF);

  settingsPortalActive = false;
}

void processSettingsPortal() {
  if (!settingsPortalActive) return;

  dnsServer.processNextRequest();
  server.handleClient();
}

void setup() {
  Serial.begin(115200);
  delay(1000);

  gfx->begin();
  gfx->fillScreen(COLOR_BLACK);

  SPI.begin(TFT_SCLK, TFT_MISO, TFT_MOSI);

  touch.begin();
  touch.setRotation(1);

  settingsApPassword = generateApPassword();
  loadSavedPasswords();

  drawBootScreen();
  delay(1200);
  drawMenu();

  Keyboard.begin();
  USB.begin();

  delay(800);
}

void loop() {
  processSettingsPortal();
  if (currentScreen == SCREEN_TOTP_VIEW) {
    time_t nowTime;

    if (getCurrentUnixTime(nowTime)) {
      int secondsRemaining = 30 - (nowTime % 30);

      if (lastTotpRedraw != (unsigned long)nowTime) {
        if (activeTotp != nullptr && activeTotpEntryIndex >= 0) {
          char* code = activeTotp->getCode(nowTime);
          showTotpCodeScreen(passwordNameValues[activeTotpEntryIndex], code, secondsRemaining);
        }
        lastTotpRedraw = (unsigned long)nowTime;
      }
    }
  }
  
  handleTouch();
  delay(20);
}
