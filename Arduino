void openSelectedItem() {
  if (currentScreen == SCREEN_MAIN) {
    if (selectedIndex == 0) {
      currentScreen = SCREEN_PASSWORDS;
      selectedIndex = 0;
      menuScrollOffset = 0;
      drawMenu();
      return;
    }

    if (selectedIndex == 1) {
      currentScreen = SCREEN_TOTP;
      selectedIndex = 0;
      menuScrollOffset = 0;
      drawMenu();
      return;
    }

    if (selectedIndex == 2) {
      currentScreen = SCREEN_SETTINGS;
      gfx->fillScreen(COLOR_BLACK);
      gfx->setTextColor(COLOR_WHITE, COLOR_BLACK);
      gfx->setTextSize(2);
      gfx->setCursor(30, 80);
      gfx->println("Settings Portal");
      gfx->setCursor(30, 120);
      gfx->println("Coming later");
      gfx->setTextSize(1);
      gfx->setCursor(8, 225);
      gfx->println("< Back");
      return;
    }
  }

  if (currentScreen == SCREEN_PASSWORDS) {
    activePasswordIndex = selectedIndex;
    currentScreen = SCREEN_PASSWORD_ACTIONS;
    selectedIndex = 0;
    menuScrollOffset = 0;
    drawMenu();
    return;
  }

  if (currentScreen == SCREEN_TOTP) {
    if (!timeSynced) {
      if (!syncTimeOverWiFi()) {
        drawMenu();
        return;
      }

      timeSynced = true;
    }

    currentScreen = SCREEN_TOTP_VIEW;
    lastTotpRedraw = 0;
    return;
  }

  if (currentScreen == SCREEN_PASSWORD_ACTIONS) {
    showSendingScreen(passwordMenuItems[activePasswordIndex]);
    delay(300);

    if (selectedIndex == 0) {
      Keyboard.print(passwordUsernames[activePasswordIndex]);
    } else if (selectedIndex == 1) {
      Keyboard.print(passwordValues[activePasswordIndex]);
    } else if (selectedIndex == 2) {
      Keyboard.print(passwordUsernames[activePasswordIndex]);
      Keyboard.write(KEY_TAB);
      Keyboard.print(passwordValues[activePasswordIndex]);
    }

    delay(600);
    drawMenu();
    return;
  }
}

void handleTouch() {
  static unsigned long lastTouchMs = 0;

  if (!touch.touched()) return;

  unsigned long now = millis();

  if (now - lastTouchMs < 250) return;
  lastTouchMs = now;

  TS_Point p = touch.getPoint();

  int x = map(p.x, 200, 3900, 0, gfx->width());
  int y = map(p.y, 200, 3900, 0, gfx->height());

  if (currentScreen == SCREEN_TOTP_VIEW) {
    if (x < 130 && y > 190) {
      handleBackAction();
      return;
    }
    if (x >= 30 && x <= 290 && y >= 55 && y <= 150) {
      time_t nowTime;

      if (!getCurrentUnixTime(nowTime)) {
        return;
      }

      char* code = gmailTotp->getCode(nowTime);
      Keyboard.print(code);

      showSendingScreen("Google TOTP");
      delay(600);

      lastTotpRedraw = 0;
      return;
    }

    return;
  }

  Serial.print("Touch x=");
  Serial.print(x);
  Serial.print(" y=");
  Serial.println(y);

  // Large back button zone
  if (currentScreen != SCREEN_MAIN && x < 130 && y > 190) {
    handleBackAction();
    return;
  }

  int itemCount = getCurrentMenuCount();

  if (itemCount <= 0) {
    return;
  }

  const int startY = 58;
  const int cardHeight = 38;
  const int cardGap = 8;
  const int visibleItems = 4;

  for (int row = 0; row < visibleItems; row++) {
    int cardY = startY + row * (cardHeight + cardGap);
    int tappedIndex = menuScrollOffset + row;

    if (tappedIndex >= itemCount) continue;

    if (x >= 14 && x <= 306 && y >= cardY && y <= cardY + cardHeight) {
      selectedIndex = tappedIndex;
      drawMenu();
      delay(120);
      openSelectedItem();
      return;
    }
  }
}

int base32Value(char c) {
  if (c >= 'A' && c <= 'Z') return c - 'A';
  if (c >= 'a' && c <= 'z') return c - 'a';
  if (c >= '2' && c <= '7') return c - '2' + 26;
  return -1;
}

size_t decodeBase32(const char* input, uint8_t* output, size_t maxOutputLen) {
  int buffer = 0;
  int bitsLeft = 0;
  size_t outLen = 0;

  while (*input) {
    char c = *input++;

    if (c == ' ' || c == '=' || c == '-') continue;

    int val = base32Value(c);
    if (val < 0) continue;

    buffer = (buffer << 5) | val;
    bitsLeft += 5;

    if (bitsLeft >= 8) {
      bitsLeft -= 8;

      if (outLen >= maxOutputLen) return 0;

      output[outLen++] = (buffer >> bitsLeft) & 0xFF;
    }
  }

  return outLen;
}

bool initTotp() {
  gmailTotpSecretLen = decodeBase32(
    GMAIL_TOTP_BASE32,
    gmailTotpSecret,
    sizeof(gmailTotpSecret)
  );

  if (gmailTotpSecretLen == 0) {
    return false;
  }

  gmailTotp = new TOTP(gmailTotpSecret, gmailTotpSecretLen);
  return true;
}

