bool syncTimeOverWiFi() {
  showStatusScreen("Connecting WiFi", "Syncing time...");

  WiFi.mode(WIFI_STA);
  WiFi.disconnect(true);
  delay(300);

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);

  unsigned long start = millis();

  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(250);
  }

  if (WiFi.status() != WL_CONNECTED) {
    showStatusScreen("WiFi Failed", "Check SSID/password");
    delay(1500);
    return false;
  }

  configTime(GMT_OFFSET_SEC, DAYLIGHT_OFFSET_SEC, NTP_SERVER_1, NTP_SERVER_2);

  struct tm timeinfo;
  start = millis();

  while (millis() - start < 20000) {
    if (getLocalTime(&timeinfo)) {
      WiFi.disconnect(true);
      WiFi.mode(WIFI_OFF);

      showStatusScreen("Time Synced", "Ready");
      delay(700);
      return true;
    }

    delay(250);
  }

  showStatusScreen("Time Failed", "NTP error");
  delay(1500);
  return false;
}

bool getCurrentUnixTime(time_t &unixTime) {
  time(&unixTime);
  return unixTime > 1700000000;
}

