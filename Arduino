void setup() {
  Serial.begin(115200);
  delay(1000);

  gfx->begin();
  gfx->fillScreen(COLOR_BLACK);

  SPI.begin(TFT_SCLK, TFT_MISO, TFT_MOSI);

  touch.begin();
  touch.setRotation(1);

  if (!initTotp()) {
    gfx->fillScreen(COLOR_BLACK);
    gfx->setTextColor(COLOR_RED, COLOR_BLACK);
    gfx->setTextSize(2);
    gfx->setCursor(25, 80);
    gfx->println("TOTP Error");
    gfx->setCursor(25, 120);
    gfx->println("Bad Base32");
    while (true) delay(1000);
  }

  drawBootScreen();
  delay(1200);
  drawMenu();

  Keyboard.begin();
  USB.begin();

  delay(800);
}

void loop() {

  if (currentScreen == SCREEN_TOTP_VIEW) {
    time_t nowTime;

    if (getCurrentUnixTime(nowTime)) {
      int secondsRemaining = 30 - (nowTime % 30);
      if (secondsRemaining == 30) secondsRemaining = 0;

      if (lastTotpRedraw != (unsigned long)nowTime) {
        char* code = gmailTotp->getCode(nowTime);
        showTotpCodeScreen("Google TOTP", code, secondsRemaining);
        lastTotpRedraw = (unsigned long)nowTime;
      }
    }
  }
  
  handleTouch();
  delay(20);
}
