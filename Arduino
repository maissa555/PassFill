int getCurrentMenuCount() {
  if (currentScreen == SCREEN_MAIN) return 3;
  if (currentScreen == SCREEN_PASSWORDS) return 4;
  if (currentScreen == SCREEN_PASSWORD_ACTIONS) return 3;
  if (currentScreen == SCREEN_TOTP) return 1;
  if (currentScreen == SCREEN_SETTINGS) return 0;
