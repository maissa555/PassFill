void drawMenu() {
  gfx->fillScreen(COLOR_BLACK);

  // Header
  gfx->fillRoundRect(8, 8, 304, 38, 8, COLOR_DARKGREY);
  gfx->setTextColor(COLOR_WHITE, COLOR_DARKGREY);
  gfx->setTextSize(2);
  gfx->setCursor(18, 19);
  gfx->println(getScreenTitle());

  int itemCount = getCurrentMenuCount();

  const int startY = 58;
  const int cardHeight = 38;
  const int cardGap = 8;
  const int visibleItems = 4;

  if (selectedIndex < menuScrollOffset) {
    menuScrollOffset = selectedIndex;
  }

  if (selectedIndex >= menuScrollOffset + visibleItems) {
    menuScrollOffset = selectedIndex - visibleItems + 1;
  }

  if (menuScrollOffset < 0) menuScrollOffset = 0;
  if (itemCount <= visibleItems) menuScrollOffset = 0;

  int endIndex = menuScrollOffset + visibleItems;
  if (endIndex > itemCount) endIndex = itemCount;

  int y = startY;

  for (int i = menuScrollOffset; i < endIndex; i++) {
    uint16_t bgColor = (i == selectedIndex) ? COLOR_LIGHTGREY : COLOR_DARKGREY;
    uint16_t textColor = (i == selectedIndex) ? COLOR_GREEN : COLOR_WHITE;

    gfx->fillRoundRect(14, y, 292, cardHeight, 8, bgColor);
    gfx->drawRoundRect(14, y, 292, cardHeight, 8, COLOR_WHITE);

    gfx->setTextColor(textColor, bgColor);
    gfx->setTextSize(2);
    gfx->setCursor(28, y + 11);
    gfx->println(getCurrentMenuItem(i));

    y += cardHeight + cardGap;
  }

  // Bottom navigation bar
  gfx->fillRect(0, 205, 320, 35, COLOR_BLACK);

  if (currentScreen != SCREEN_MAIN) {
    gfx->fillRoundRect(8, 205, 105, 30, 6, COLOR_DARKGREY);
    gfx->setTextColor(COLOR_WHITE, COLOR_DARKGREY);
    gfx->setTextSize(2);
    gfx->setCursor(24, 213);
    gfx->print("Back");
  }

  gfx->setTextColor(COLOR_CYAN, COLOR_BLACK);
  gfx->setTextSize(1);
  gfx->setCursor(210, 218);
  gfx->print("Tap to select");
}
void handleBackAction() {
  if (currentScreen == SCREEN_MAIN) {
    drawMenu();
    return;
  }

  if (currentScreen == SCREEN_PASSWORD_ACTIONS) {
    currentScreen = SCREEN_PASSWORDS;
    selectedIndex = activePasswordIndex;
    menuScrollOffset = 0;
    drawMenu();
    return;
  }

  if (currentScreen == SCREEN_TOTP_VIEW) {
    currentScreen = SCREEN_TOTP;
    selectedIndex = 0;
    menuScrollOffset = 0;
    drawMenu();
    return;
  }

  currentScreen = SCREEN_MAIN;
  selectedIndex = 0;
  menuScrollOffset = 0;
  drawMenu();
}

